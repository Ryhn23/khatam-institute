# Dependencies
node_modules/
package-lock.json.bak

# SQLite Database & Storage (Prevent committing sensitive database data)
database.sqlite
database.sqlite*
*.sqlite
*.sqlite3
*.db
*.db-journal

# Uploads directory (Exclude uploaded media files, preserve directory via .gitkeep)
public/uploads/*
!public/uploads/.gitkeep

# Environment & Secrets
.env
.env.*
!.env.example

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# Operating System & Editor Files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Docker local overrides
docker-compose.override.yml
