# Environment Configuration for Khatam Institute
# Copy to .env and adjust values for production deployment

NODE_ENV=production
PORT=7575

# Session Security (Generate a long random string: openssl rand -hex 32)
SESSION_SECRET=change-this-to-a-very-long-random-secret-key-in-production

# HTTPS Cookie Security (Set to true if domain has SSL/HTTPS enabled via reverse proxy)
COOKIE_SECURE=true
