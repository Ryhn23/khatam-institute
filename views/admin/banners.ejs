<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kelola Banner Hero | Redaksi <%= settings.site_name || 'Khatam Institute' %></title>
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <link rel="stylesheet" href="/css/output.css?v=4">
    <!-- Theme Script -->
    <script src="/theme.js"></script>
</head>
<body class="bg-[#FCFCFB] dark:bg-[#141414] font-sans min-h-screen flex flex-col transition-colors duration-200">
    <%- include('../partials/admin-navbar', { page: 'banners' }) %>

    <main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
            <div>
                <h1 class="font-serif text-3xl font-bold text-neutral-900 dark:text-neutral-100 tracking-tight">Kelola Banner Hero</h1>
                <p class="text-neutral-500 dark:text-neutral-400 text-sm mt-1">Banner ini tampil di hero carousel halaman beranda.</p>
            </div>
            <a href="/admin/banners/new" class="bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 px-5 py-2.5 rounded-full text-xs uppercase tracking-wider font-semibold hover:bg-neutral-800 dark:hover:bg-neutral-100 transition flex items-center justify-center gap-2 self-start sm:self-auto shadow-sm">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                Tambah Banner Baru
            </a>
        </div>

        <% if (error) { %>
            <div class="bg-red-50 dark:bg-red-950/40 text-red-700 dark:text-red-300 p-4 rounded-xl mb-6 border border-red-200 dark:border-red-900/50 text-sm">
                <%= error %>
            </div>
        <% } %>

        <% if (success) { %>
            <div class="bg-green-50 dark:bg-green-950/40 text-green-700 dark:text-green-300 p-4 rounded-xl mb-6 border border-green-200 dark:border-green-900/50 text-sm">
                <%= success %>
            </div>
        <% } %>

        <div class="bg-white dark:bg-[#1A1A1A] rounded-2xl shadow-sm border border-black/[0.08] dark:border-white/[0.08] overflow-hidden">
            <div class="p-5 border-b border-black/[0.06] dark:border-white/[0.08] flex justify-between items-center bg-neutral-50/50 dark:bg-neutral-900/50">
                <h2 class="text-xs uppercase tracking-wider font-semibold text-neutral-600 dark:text-neutral-300">Total Banner: <%= banners.length %></h2>
            </div>
            
            <% if (banners.length > 0) { %>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="border-b border-black/[0.06] dark:border-white/[0.08] text-neutral-500 dark:text-neutral-400 text-[11px] uppercase tracking-wider">
                                <th class="p-4 font-semibold">Preview</th>
                                <th class="p-4 font-semibold">Judul & Deskripsi</th>
                                <th class="p-4 font-semibold">Tombol / Tautan</th>
                                <th class="p-4 font-semibold text-center">Urutan</th>
                                <th class="p-4 font-semibold text-center">Status</th>
                                <th class="p-4 font-semibold text-right">Aksi</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-black/[0.05] dark:divide-white/[0.06]">
                            <% banners.forEach(banner => { %>
                                <tr class="hover:bg-neutral-50/80 dark:hover:bg-neutral-800/40 transition">
                                    <td class="p-4 w-36">
                                        <div class="w-28 h-16 rounded-lg overflow-hidden bg-neutral-100 dark:bg-neutral-800 border border-black/[0.08] dark:border-white/[0.08]">
                                            <img src="<%= banner.image_url %>" alt="<%= banner.title %>" class="w-full h-full object-cover">
                                        </div>
                                    </td>
                                    <td class="p-4">
                                        <div class="font-serif font-bold text-neutral-900 dark:text-neutral-100 text-sm mb-0.5"><%= banner.title || '(Tanpa Judul)' %></div>
                                        <div class="text-xs text-neutral-500 dark:text-neutral-400 line-clamp-2"><%= banner.subtitle || '-' %></div>
                                    </td>
                                    <td class="p-4 text-xs text-neutral-600 dark:text-neutral-400">
                                        <% if (banner.button_text) { %>
                                            <span class="inline-block bg-neutral-100 dark:bg-neutral-800 border border-black/[0.06] dark:border-white/[0.08] px-2 py-0.5 rounded text-[11px] font-medium mb-1"><%= banner.button_text %></span><br>
                                        <% } %>
                                        <span class="truncate max-w-xs block font-mono text-[11px] text-neutral-500"><%= banner.link_url || '-' %></span>
                                    </td>
                                    <td class="p-4 text-center font-mono text-xs font-semibold text-neutral-700 dark:text-neutral-300">
                                        <%= banner.order_num %>
                                    </td>
                                    <td class="p-4 text-center">
                                        <% if (banner.is_active) { %>
                                            <span class="bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 text-[11px] px-2.5 py-0.5 rounded-full font-semibold">Aktif</span>
                                        <% } else { %>
                                            <span class="bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400 text-[11px] px-2.5 py-0.5 rounded-full font-semibold">Nonaktif</span>
                                        <% } %>
                                    </td>
                                    <td class="p-4 text-right space-x-3 whitespace-nowrap text-xs font-semibold">
                                        <a href="/admin/banners/<%= banner.id %>/edit" class="text-amber-700 dark:text-amber-400 hover:underline">Edit</a>
                                        <form action="/admin/banners/<%= banner.id %>/delete" method="POST" class="inline-block" onsubmit="return confirm('Yakin ingin menghapus banner ini?');">
                                            <button type="submit" class="text-red-600 dark:text-red-400 hover:underline">Hapus</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="p-12 text-center text-neutral-500 dark:text-neutral-400">
                    <p class="font-serif text-lg mb-2">Belum ada banner di carousel.</p>
                    <a href="/admin/banners/new" class="text-amber-700 dark:text-amber-400 underline text-sm">Tambah banner sekarang</a>
                </div>
            <% } %>
        </div>
    </main>
</body>
</html>
