<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profil Lembaga & Tentang | Redaksi <%= settings.site_name || 'Khatam Institute' %></title>
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <link rel="stylesheet" href="/css/output.css?v=5">
    <!-- Theme Script -->
    <script src="/theme.js"></script>
</head>
<body class="bg-[#FCFCFB] dark:bg-[#141414] font-sans min-h-screen flex flex-col transition-colors duration-200">
    <%- include('../partials/admin-navbar', { page: 'homepage' }) %>

    <main class="flex-grow max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full">
        <div class="mb-8">
            <h1 class="font-serif text-3xl font-bold text-neutral-900 dark:text-neutral-100 tracking-tight">Kelola Profil Lembaga & Halaman Tentang</h1>
            <p class="text-neutral-500 dark:text-neutral-400 text-sm mt-1">Ubah narasi profil lembaga di beranda, konten lengkap Halaman Tentang (/tentang), visi-misi, pilar tujuan, dan kontak.</p>
        </div>

        <% if (error) { %>
            <div class="bg-red-50 dark:bg-red-950/40 text-red-700 dark:text-red-300 p-4 rounded-xl mb-6 border border-red-200 dark:border-red-900/50 text-sm">
                <%= error %>
            </div>
        <% } %>

        <% if (success) { %>
            <div class="bg-green-50 dark:bg-green-950/40 text-green-700 dark:text-green-300 p-4 rounded-xl mb-6 border border-green-200 dark:border-green-900/50 text-sm">
                <%= success %>
            </div>
        <% } %>

        <form action="/admin/homepage" method="POST" class="space-y-8">
            
            <!-- Profil Situs & Identitas -->
            <div class="bg-white dark:bg-[#1A1A1A] rounded-2xl shadow-sm border border-black/[0.08] dark:border-white/[0.08] p-6 sm:p-8">
                <h2 class="text-xs uppercase tracking-wider font-semibold text-neutral-900 dark:text-neutral-100 mb-6 border-b border-black/[0.06] dark:border-white/[0.08] pb-3">
                    Identitas Lembaga
                </h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div>
                        <label class="block text-xs uppercase tracking-wider font-semibold text-neutral-700 dark:text-neutral-300 mb-2">Nama Lembaga</label>
                        <input type="text" name="site_name" value="<%= settings.site_name || 'Khatam Institute' %>" class="w-full px-4 py-2.5 border border-neutral-300 dark:border-neutral-700 rounded-lg bg-white dark:bg-[#202020] text-neutral-900 dark:text-neutral-100 focus:ring-2 focus:ring-amber-500/50 focus:border-amber-500 text-sm">
                    </div>
                    <div>
                        <label class="block text-xs uppercase tracking-wider font-semibold text-neutral-700 dark:text-neutral-300 mb-2">Tagline Ringkas</label>
                        <input type="text" name="site_tagline" value="<%= settings.site_tagline || '' %>" class="w-full px-4 py-2.5 border border-neutral-300 dark:border-neutral-700 rounded-lg bg-white dark:bg-[#202020] text-neutral-900 dark:text-neutral-100 focus:ring-2 focus:ring-amber-500/50 focus:border-amber-500 text-sm">
                    </div>
                </div>
            </div>

            <!-- Bagian Tentang Kami -->
            <div class="bg-white dark:bg-[#1A1A1A] rounded-2xl shadow-sm border border-black/[0.08] dark:border-white/[0.08] p-6 sm:p-8">
                <h2 class="text-xs uppercase tracking-wider font-semibold text-neutral-900 dark:text-neutral-100 mb-6 border-b border-black/[0.06] dark:border-white/[0.08] pb-3">
                    Profil & Narasi Manifesto (Beranda)
                </h2>
                <div class="mb-5">
                    <label class="block text-xs uppercase tracking-wider font-semibold text-neutral-700 dark:text-neutral-300 mb-2">Judul Seksi Profil</label>
                    <input type="text" name="about_title" value="<%= settings.about_title || 'Profil Khatam Institute' %>" class="w-full px-4 py-2.5 border border-neutral-300 dark:border-neutral-700 rounded-lg bg-white dark:bg-[#202020] text-neutral-900 dark:text-neutral-100 focus:ring-2 focus:ring-amber-500/50 focus:border-amber-500 text-sm font-serif">
                </div>
                <div class="mb-5">
                    <label class="block text-xs uppercase tracking-wider font-semibold text-neutral-700 dark:text-neutral-300 mb-2">Deskripsi Singkat Profil Lembaga</label>
                    <textarea name="about_description" rows="3" class="w-full px-4 py-2.5 border border-neutral-300 dark:border-neutral-700 rounded-lg bg-white dark:bg-[#202020] text-neutral-900 dark:text-neutral-100 focus:ring-2 focus:ring-amber-500/50 focus:border-amber-500 text-sm font-serif leading-relaxed"><%= settings.about_description || '' %></textarea>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div>
                        <label class="block text-xs uppercase tracking-wider font-semibold text-neutral-700 dark:text-neutral-300 mb-2">Visi Lembaga</label>
                        <textarea name="vision" rows="4" class="w-full px-4 py-2.5 border border-neutral-300 dark:border-neutral-700 rounded-lg bg-white dark:bg-[#202020] text-neutral-900 dark:text-neutral-100 focus:ring-2 focus:ring-amber-500/50 focus:border-amber-500 text-sm font-serif leading-relaxed"><%= settings.vision || '' %></textarea>
                    </div>
                    <div>
                        <label class="block text-xs uppercase tracking-wider font-semibold text-neutral-700 dark:text-neutral-300 mb-2">Misi Lembaga (Tiap baris 1 poin)</label>
                        <textarea name="mission" rows="4" class="w-full px-4 py-2.5 border border-neutral-300 dark:border-neutral-700 rounded-lg bg-white dark:bg-[#202020] text-neutral-900 dark:text-neutral-100 focus:ring-2 focus:ring-amber-500/50 focus:border-amber-500 text-sm font-serif leading-relaxed"><%= settings.mission || '' %></textarea>
                    </div>
                </div>
            </div>

            <!-- Konten Lengkap Halaman Tentang (/tentang) -->
            <div class="bg-white dark:bg-[#1A1A1A] rounded-2xl shadow-sm border border-black/[0.08] dark:border-white/[0.08] p-6 sm:p-8">
                <div class="flex items-center justify-between mb-6 border-b border-black/[0.06] dark:border-white/[0.08] pb-3">
                    <div>
                        <h2 class="text-xs uppercase tracking-wider font-semibold text-neutral-900 dark:text-neutral-100">
                            Konten Halaman Tentang (/tentang)
                        </h2>
                        <span class="text-xs text-neutral-500 dark:text-neutral-400">Pengaturan konten khusus untuk laman tersendiri /tentang</span>
                    </div>
                    <a href="/tentang" target="_blank" class="text-xs font-semibold text-amber-700 dark:text-amber-400 hover:underline inline-flex items-center gap-1">
                        Pratinjau Laman
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                    </a>
                </div>
                
                <div class="mb-5">
                    <label class="block text-xs uppercase tracking-wider font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
                        Judul Utama Halaman Tentang
                    </label>
                    <input type="text" name="about_hero_title" value="<%= settings.about_hero_title || '' %>" placeholder="Membangun Tradisi Riset, Menegakkan Nalar Kritis, dan Menumbuhkan Keilmuan Peradaban" class="w-full px-4 py-2.5 border border-neutral-300 dark:border-neutral-700 rounded-lg bg-white dark:bg-[#202020] text-neutral-900 dark:text-neutral-100 focus:ring-2 focus:ring-amber-500/50 focus:border-amber-500 text-sm font-serif">
                    <span class="text-[11px] text-neutral-500 dark:text-neutral-400 mt-1 block">Tajuk besar di atas halaman /tentang. Kosongkan untuk menggunakan judul standar.</span>
                </div>

                <div class="mb-5">
                    <label class="block text-xs uppercase tracking-wider font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
                        Latar Belakang & Filosofi Gerakan (Laman /tentang)
                    </label>
                    <textarea name="about_philosophy" rows="7" placeholder="Tuliskan latar belakang pendirian lembaga, titik tolak intelektual, dan filosofi gerakan. Mendukung baris baru/paragraf." class="w-full px-4 py-2.5 border border-neutral-300 dark:border-neutral-700 rounded-lg bg-white dark:bg-[#202020] text-neutral-900 dark:text-neutral-100 focus:ring-2 focus:ring-amber-500/50 focus:border-amber-500 text-sm font-serif leading-relaxed"><%= settings.about_philosophy || '' %></textarea>
                    <span class="text-[11px] text-neutral-500 dark:text-neutral-400 mt-1 block">Tampil di seksi "01 / Filosofi Gerakan". Jika kosong, teks filosofi bawaan akan ditampilkan.</span>
                </div>

                <div>
                    <label class="block text-xs uppercase tracking-wider font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
                        Keterangan Fokus Kajian Riset (Opsional)
                    </label>
                    <textarea name="about_focus" rows="3" placeholder="Tuliskan catatan atau deskripsi penegasan fokus bidang riset khusus jika ingin menambah/mengubah tampilan standar." class="w-full px-4 py-2.5 border border-neutral-300 dark:border-neutral-700 rounded-lg bg-white dark:bg-[#202020] text-neutral-900 dark:text-neutral-100 focus:ring-2 focus:ring-amber-500/50 focus:border-amber-500 text-sm font-serif leading-relaxed"><%= settings.about_focus || '' %></textarea>
                    <span class="text-[11px] text-neutral-500 dark:text-neutral-400 mt-1 block">Tampil di seksi "04 / Ruang Lingkup". Jika dikosongkan, 4 kartu bidang kajian default akan otomatis ditampilkan.</span>
                </div>
            </div>

            <!-- 4 Pilar Utama -->
            <div class="bg-white dark:bg-[#1A1A1A] rounded-2xl shadow-sm border border-black/[0.08] dark:border-white/[0.08] p-6 sm:p-8">
                <h2 class="text-xs uppercase tracking-wider font-semibold text-neutral-900 dark:text-neutral-100 mb-6 border-b border-black/[0.06] dark:border-white/[0.08] pb-3">
                    4 Pilar Tujuan Strategis
                </h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <div>
                        <label class="block text-xs font-semibold text-neutral-600 dark:text-neutral-400 mb-1.5">Pilar 01</label>
                        <input type="text" name="goal_1" value="<%= settings.goal_1 || '' %>" class="w-full px-4 py-2.5 border border-neutral-300 dark:border-neutral-700 rounded-lg bg-white dark:bg-[#202020] text-neutral-900 dark:text-neutral-100 text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-neutral-600 dark:text-neutral-400 mb-1.5">Pilar 02</label>
                        <input type="text" name="goal_2" value="<%= settings.goal_2 || '' %>" class="w-full px-4 py-2.5 border border-neutral-300 dark:border-neutral-700 rounded-lg bg-white dark:bg-[#202020] text-neutral-900 dark:text-neutral-100 text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-neutral-600 dark:text-neutral-400 mb-1.5">Pilar 03</label>
                        <input type="text" name="goal_3" value="<%= settings.goal_3 || '' %>" class="w-full px-4 py-2.5 border border-neutral-300 dark:border-neutral-700 rounded-lg bg-white dark:bg-[#202020] text-neutral-900 dark:text-neutral-100 text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-neutral-600 dark:text-neutral-400 mb-1.5">Pilar 04</label>
                        <input type="text" name="goal_4" value="<%= settings.goal_4 || '' %>" class="w-full px-4 py-2.5 border border-neutral-300 dark:border-neutral-700 rounded-lg bg-white dark:bg-[#202020] text-neutral-900 dark:text-neutral-100 text-sm">
                    </div>
                </div>
            </div>

            <!-- Kontak & Footer -->
            <div class="bg-white dark:bg-[#1A1A1A] rounded-2xl shadow-sm border border-black/[0.08] dark:border-white/[0.08] p-6 sm:p-8">
                <h2 class="text-xs uppercase tracking-wider font-semibold text-neutral-900 dark:text-neutral-100 mb-6 border-b border-black/[0.06] dark:border-white/[0.08] pb-3">
                    Kontak & Informasi Redaksi
                </h2>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-5">
                    <div>
                        <label class="block text-xs font-semibold text-neutral-600 dark:text-neutral-400 mb-1.5">Surel / Email</label>
                        <input type="email" name="contact_email" value="<%= settings.contact_email || '' %>" class="w-full px-4 py-2.5 border border-neutral-300 dark:border-neutral-700 rounded-lg bg-white dark:bg-[#202020] text-neutral-900 dark:text-neutral-100 text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-neutral-600 dark:text-neutral-400 mb-1.5">Nomor Telepon</label>
                        <input type="text" name="contact_phone" value="<%= settings.contact_phone || '' %>" class="w-full px-4 py-2.5 border border-neutral-300 dark:border-neutral-700 rounded-lg bg-white dark:bg-[#202020] text-neutral-900 dark:text-neutral-100 text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-neutral-600 dark:text-neutral-400 mb-1.5">Teks Ringkas Footer</label>
                        <input type="text" name="footer_text" value="<%= settings.footer_text || '' %>" class="w-full px-4 py-2.5 border border-neutral-300 dark:border-neutral-700 rounded-lg bg-white dark:bg-[#202020] text-neutral-900 dark:text-neutral-100 text-sm">
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-neutral-600 dark:text-neutral-400 mb-1.5">Alamat Lembaga</label>
                    <textarea name="contact_address" rows="2" class="w-full px-4 py-2.5 border border-neutral-300 dark:border-neutral-700 rounded-lg bg-white dark:bg-[#202020] text-neutral-900 dark:text-neutral-100 text-sm leading-relaxed"><%= settings.contact_address || '' %></textarea>
                </div>
            </div>

            <div class="flex justify-end">
                <button type="submit" class="bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 font-semibold px-8 py-3 rounded-full text-xs uppercase tracking-wider hover:bg-neutral-800 dark:hover:bg-neutral-100 transition shadow-sm">
                    Simpan Perubahan
                </button>
            </div>
        </form>
    </main>
</body>
</html>
