</main>

<!-- Medium-style Minimal & Elegant Editorial Footer -->
<footer
    class="border-t border-black/[0.08] dark:border-white/[0.08] bg-[#FCFCFB] dark:bg-[#141414] py-14 transition-colors duration-200 mt-auto">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-10 items-start">

            <!-- Brand & Mission Column -->
            <div class="md:col-span-5 space-y-3">
                <div class="flex items-center gap-3">
                    <img src="/khatam-institute.png" alt="Logo" class="h-8 w-auto object-contain dark:brightness-110">
                    <span class="font-serif font-bold text-lg text-neutral-900 dark:text-neutral-100">
                        <%= settings.site_name || 'Khatam Institute' %>
                    </span>
                </div>
                <p class="font-serif text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed max-w-sm">
                    <%= settings.footer_text || settings.about_description
                        || 'Pusat kajian riset, telaah nalar kritis, dan pembinaan tradisi intelektual peradaban.' %>
                </p>
            </div>

            <!-- Navigation Links -->
            <div class="md:col-span-3 space-y-3">
                <h4 class="text-xs uppercase tracking-wider font-semibold text-neutral-900 dark:text-neutral-100">
                    Navigasi
                </h4>
                <ul class="space-y-2 text-sm text-neutral-600 dark:text-neutral-400">
                    <li><a href="/" class="hover:text-neutral-950 dark:hover:text-white transition">Beranda</a></li>
                    <li><a href="/#profil" class="hover:text-neutral-950 dark:hover:text-white transition">Profil
                            Lembaga</a></li>
                    <li><a href="/tentang" class="hover:text-neutral-950 dark:hover:text-white transition">Tentang
                            Kami</a></li>
                    <li><a href="/blog" class="hover:text-neutral-950 dark:hover:text-white transition">Arsip Tulisan &
                            Riset</a></li>
                    <li><a href="/admin" class="hover:text-neutral-950 dark:hover:text-white transition">Portal
                            Redaksi</a></li>
                </ul>
            </div>

            <!-- Contact & Info -->
            <div class="md:col-span-4 space-y-3">
                <h4 class="text-xs uppercase tracking-wider font-semibold text-neutral-900 dark:text-neutral-100">
                    Hubungi Redaksi
                </h4>
                <div class="text-sm text-neutral-600 dark:text-neutral-400 space-y-2 leading-relaxed">
                    <% if (settings.contact_email) { %>
                        <p>Surel: <a href="mailto:<%= settings.contact_email %>"
                                class="text-neutral-900 dark:text-neutral-200 underline">
                                <%= settings.contact_email %>
                            </a></p>
                        <% } %>
                            <% if (settings.contact_phone) { %>
                                <p>Telepon: <%= settings.contact_phone %>
                                </p>
                                <% } %>
                                    <% if (settings.contact_address) { %>
                                        <p class="text-xs text-neutral-500 dark:text-neutral-400">
                                            <%= settings.contact_address %>
                                        </p>
                                        <% } %>
                </div>
            </div>

        </div>

        <!-- Bottom Copyright & Colophon -->
        <div
            class="mt-12 pt-8 border-t border-black/[0.06] dark:border-white/[0.06] flex flex-col sm:flex-row justify-between items-center text-xs text-neutral-400 dark:text-neutral-500 gap-4">
            <p>&copy; <%= new Date().getFullYear() %>
                    <%= settings.site_name || 'Khatam Institute' %>. Hak cipta dilindungi undang-undang.</p>
        </div>
    </div>
</footer>

</div>

<!-- AOS Animation JS -->
<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
<!-- Swiper Carousel JS -->
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script>
    AOS.init({
        duration: 400,
        once: true,
        offset: 40,
        easing: 'ease-out'
    });
</script>
</body>

</html>