<%- include('partials/header', { title: post.title, meta_description: post.meta_description }) %>

    <% const plainText=(post.content || '' ).replace(/<[^>]+>/g, ' ');
        const words = plainText.trim().split(/\s+/).filter(Boolean).length;
        const readTime = Math.max(1, Math.ceil(words / 200));
        %>

        <article class="min-h-screen py-10 md:py-16 transition-colors duration-200">
            <div class="max-w-[720px] mx-auto px-4 sm:px-6">

                <!-- Back Navigation & Category -->
                <div
                    class="flex items-center justify-between text-xs font-medium text-neutral-500 dark:text-neutral-400 mb-8">
                    <a href="/blog"
                        class="inline-flex items-center gap-1.5 hover:text-neutral-900 dark:hover:text-white transition group">
                        <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5" fill="none"
                            stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7">
                            </path>
                        </svg>
                        Semua Artikel
                    </a>
                    <% if (post.category_name) { %>
                        <a href="/blog?category=<%= post.category_slug %>"
                            class="uppercase tracking-widest text-[11px] font-semibold text-amber-700 dark:text-amber-400 hover:underline">
                            <%= post.category_name %>
                        </a>
                        <% } else { %>
                            <span
                                class="uppercase tracking-widest text-[11px] font-semibold text-amber-700 dark:text-amber-400">
                                Kajian & Riset
                            </span>
                            <% } %>
                </div>

                <!-- Article Header -->
                <header class="mb-8">
                    <h1
                        class="font-serif text-3xl sm:text-4xl md:text-[44px] font-bold text-neutral-900 dark:text-neutral-50 leading-[1.2] tracking-tight mb-6">
                        <%= post.title %>
                    </h1>

                    <% if (post.meta_description) { %>
                        <p
                            class="font-serif text-lg sm:text-xl text-neutral-600 dark:text-neutral-400 leading-relaxed mb-6 font-normal">
                            <%= post.meta_description %>
                        </p>
                        <% } %>

                            <!-- Medium-Style Author / Publication Info Bar -->
                            <div
                                class="flex items-center justify-between py-4 border-y border-black/[0.08] dark:border-white/[0.08]">
                                <div class="flex items-center gap-3.5">
                                    <div
                                        class="w-11 h-11 rounded-full bg-neutral-100 dark:bg-neutral-800 border border-black/[0.08] dark:border-white/[0.08] flex items-center justify-center overflow-hidden flex-shrink-0">
                                        <img src="/khatam-institute.png" alt="Khatam Institute"
                                            class="h-6 w-auto object-contain dark:brightness-110">
                                    </div>
                                    <div>
                                        <div class="flex items-center gap-2">
                                            <span class="text-sm font-semibold text-neutral-900 dark:text-neutral-100">
                                                <%= settings.site_name || 'Khatam Institute' %>
                                            </span>
                                        </div>
                                        <div
                                            class="flex items-center gap-1.5 text-xs text-neutral-500 dark:text-neutral-400 mt-0.5">
                                            <time datetime="<%= post.created_at %>">
                                                <%= new Date(post.created_at).toLocaleDateString('id-ID', {
                                                    day: 'numeric' , month: 'long' , year: 'numeric' }) %>
                                            </time>
                                            <span>·</span>
                                            <span>
                                                <%= readTime %> menit baca
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Action Buttons -->
                                <div class="flex items-center gap-2 text-neutral-500 dark:text-neutral-400">
                                    <button type="button"
                                        onclick="navigator.clipboard.writeText(window.location.href); alert('Tautan artikel berhasil disalin!');"
                                        title="Salin Tautan"
                                        class="p-2 rounded-full hover:bg-neutral-100 dark:hover:bg-neutral-800 hover:text-neutral-900 dark:hover:text-white transition">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z">
                                            </path>
                                        </svg>
                                    </button>
                                </div>
                            </div>
                </header>

                <!-- Article Content (Medium Reading Experience) -->
                <div class="quill-content pt-2 pb-12">
                    <%- post.content %>
                </div>

                <!-- Article Footer & Publication Signoff (Unboxed) -->
                <footer class="pt-8 border-t border-black/[0.08] dark:border-white/[0.08] mt-8">
                    <% if (post.category_name) { %>
                        <div class="flex items-center gap-2 text-xs text-neutral-500 dark:text-neutral-400 mb-8">
                            <span>Kategori:</span>
                            <a href="/blog?category=<%= post.category_slug %>"
                                class="font-semibold text-neutral-900 dark:text-neutral-100 hover:text-amber-700 dark:hover:text-amber-400 underline underline-offset-4 transition">
                                <%= post.category_name %>
                            </a>
                        </div>
                        <% } %>
                </footer>

            </div>
        </article>

        <%- include('partials/footer') %>